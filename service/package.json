{
  "name": "archreview-service",
  "private": true,
  "version": "0.1.0",
  "description": "On-demand Architecture Review service built around oh-my-mermaid",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:parity": "vitest run --project parity",
    "test:live": "ANALYSIS_LIVE=1 vitest run --project live",
    "schemas": "tsx packages/contracts/scripts/generate-schemas.ts",
    "migrate": "tsx apps/api/src/cli/migrate.ts",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:runner": "tsx apps/runner/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
