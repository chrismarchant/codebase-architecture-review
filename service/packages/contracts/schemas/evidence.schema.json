{
  "$id": "https://archreview.local/schemas/evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "archreview.evidence/1.0"
    },
    "scanId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e_[0-9a-f]{12}$"
          },
          "subject": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "componentId": {
                    "type": "string",
                    "pattern": "^c_[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "componentId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "relationshipId": {
                    "type": "string",
                    "pattern": "^r_[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "relationshipId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "trustBoundaryId": {
                    "type": "string",
                    "pattern": "^tb_[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "trustBoundaryId"
                ],
                "additionalProperties": false
              }
            ]
          },
          "claim": {
            "type": "string",
            "maxLength": 1024
          },
          "kind": {
            "type": "string",
            "enum": [
              "observed",
              "interpretation"
            ]
          },
          "refs": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "startLine": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "endLine": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "symbol": {
                  "type": "string",
                  "maxLength": 256
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "file",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "id",
          "subject",
          "claim",
          "kind",
          "refs",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schema",
    "scanId",
    "items",
    "generatedAt"
  ],
  "additionalProperties": false
}
