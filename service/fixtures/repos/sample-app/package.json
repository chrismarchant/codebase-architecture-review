{
  "name": "sample-orders-service",
  "version": "1.4.0",
  "private": true,
  "description": "Sample fixture: HTTP orders API, Postgres-backed job queue worker, Stripe and SMTP integrations",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server/index.js",
    "worker": "node dist/workers/index.js",
    "dev": "tsx watch src/server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
