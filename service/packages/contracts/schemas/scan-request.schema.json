{
  "$id": "https://archreview.local/schemas/scan-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repository": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 512,
          "format": "uri"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "perspectives": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "language": {
          "default": "en",
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "budgets": {
          "type": "object",
          "properties": {
            "maxFiles": {
              "default": 20000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxBytes": {
              "default": 209715200,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxFileBytes": {
              "default": 1048576,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxReadBytesTotal": {
              "default": 41943040,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxReadBytesPerCall": {
              "default": 262144,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxTurns": {
              "default": 400,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxBudgetUsd": {
              "default": 5,
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxTimeSeconds": {
              "default": 2700,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxDepth": {
              "default": 4,
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "maxElements": {
              "default": 300,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "reuseExisting": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "language",
        "reuseExisting"
      ],
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    }
  },
  "required": [
    "repository",
    "options"
  ],
  "additionalProperties": false
}
