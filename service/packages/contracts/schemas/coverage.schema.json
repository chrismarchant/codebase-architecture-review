{
  "$id": "https://archreview.local/schemas/coverage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "archreview.coverage/1.0"
    },
    "scanId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "inventory": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "bytes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "byLanguage": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "files",
        "bytes",
        "byLanguage"
      ],
      "additionalProperties": false
    },
    "read": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "bytes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "files",
        "bytes"
      ],
      "additionalProperties": false
    },
    "referenced": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "unreadDirectories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "files": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "files"
        ],
        "additionalProperties": false
      }
    },
    "perspectives": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "done",
          "pending",
          "skipped_budget",
          "skipped_cancel",
          "failed"
        ]
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "hit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budgets": {
          "type": "object",
          "properties": {
            "maxFiles": {
              "default": 20000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxBytes": {
              "default": 209715200,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxFileBytes": {
              "default": 1048576,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxReadBytesTotal": {
              "default": 41943040,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxReadBytesPerCall": {
              "default": 262144,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxTurns": {
              "default": 400,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxBudgetUsd": {
              "default": 5,
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxTimeSeconds": {
              "default": 2700,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxDepth": {
              "default": 4,
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "maxElements": {
              "default": 300,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "maxFiles",
            "maxBytes",
            "maxFileBytes",
            "maxReadBytesTotal",
            "maxReadBytesPerCall",
            "maxTurns",
            "maxBudgetUsd",
            "maxTimeSeconds",
            "maxDepth",
            "maxElements"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "hit",
        "budgets"
      ],
      "additionalProperties": false
    },
    "agentStatement": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "covered": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "covered",
            "excluded",
            "notes"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schema",
    "scanId",
    "inventory",
    "read",
    "referenced",
    "excluded",
    "unreadDirectories",
    "perspectives",
    "limits",
    "agentStatement",
    "complete",
    "generatedAt"
  ],
  "additionalProperties": false
}
