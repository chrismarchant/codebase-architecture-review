{
  "$id": "https://archreview.local/schemas/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "archreview.manifest/1.0"
    },
    "scanId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "repository": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "requestedRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshotSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "url",
        "commitSha",
        "requestedRef",
        "snapshotSha256"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "gitSha": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstreamBaseline": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ommVersion": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "gitSha",
        "upstreamBaseline",
        "ommVersion"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "promptBundleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "language": {
          "type": "string"
        }
      },
      "required": [
        "runtime",
        "model",
        "effort",
        "promptBundleSha256",
        "language"
      ],
      "additionalProperties": false
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "string"
            },
            "estimatedBy": {
              "type": "string"
            },
            "totalCostUsd": {
              "type": "number",
              "minimum": 0
            },
            "turns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "apiDurationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "byModel": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "inputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "outputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cacheReadInputTokens": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cacheCreationInputTokens": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "costUsd": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "inputTokens",
                  "outputTokens",
                  "cacheReadInputTokens",
                  "cacheCreationInputTokens"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "runtime",
            "estimatedBy",
            "turns",
            "durationMs",
            "byModel"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "budgets": {
      "type": "object",
      "properties": {
        "maxFiles": {
          "default": 20000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxBytes": {
          "default": 209715200,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxFileBytes": {
          "default": 1048576,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxReadBytesTotal": {
          "default": 41943040,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxReadBytesPerCall": {
          "default": 262144,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTurns": {
          "default": 400,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxBudgetUsd": {
          "default": 5,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxTimeSeconds": {
          "default": 2700,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxDepth": {
          "default": 4,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "maxElements": {
          "default": 300,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxFiles",
        "maxBytes",
        "maxFileBytes",
        "maxReadBytesTotal",
        "maxReadBytesPerCall",
        "maxTurns",
        "maxBudgetUsd",
        "maxTimeSeconds",
        "maxDepth",
        "maxElements"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "schema": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "contentType": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256",
          "contentType"
        ],
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schema",
    "scanId",
    "attempt",
    "repository",
    "service",
    "analysis",
    "usage",
    "budgets",
    "artifacts",
    "outcome",
    "createdAt"
  ],
  "additionalProperties": false
}
